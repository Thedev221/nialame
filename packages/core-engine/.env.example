# Core Engine — configuration d'exemple. Copier vers .env et adapter.

# Adresse d'écoute. Ne JAMAIS exposer sur 0.0.0.0 sans TLS/auth/CORS/rate-limit.
NIALAME_HOST=127.0.0.1
NIALAME_PORT=8000

# LLM désactivé par défaut.
NIALAME_LLM_ENABLED=false
NIALAME_LLM_PROVIDER=ollama
NIALAME_LLM_BASE_URL=http://127.0.0.1:11434
NIALAME_LLM_MODEL=qwen2.5-coder:7b
NIALAME_LLM_TIMEOUT_SECONDS=15
NIALAME_LLM_MAX_CONCURRENCY=2

# Limites de requête
NIALAME_MAX_DOCUMENT_BYTES=524288
NIALAME_MAX_CONTEXT_CHARS=8000

# Logs structurés — JSON, jamais de code/secrets/prompt brut
NIALAME_LOG_LEVEL=INFO
