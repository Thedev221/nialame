# GitHub App — configuration d'exemple.

NIALAME_APP_HOST=127.0.0.1
NIALAME_APP_PORT=8080

# Identifiants de la GitHub App (voir docs/github-app-setup.md)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=./private-key.pem
GITHUB_WEBHOOK_SECRET=change-me-to-a-strong-random-secret

# URL du Core Engine appelé pour l'analyse déterministe
NIALAME_CORE_ENGINE_URL=http://127.0.0.1:8000

# Publication de commentaires inline sur PR — désactivé par défaut
NIALAME_ENABLE_INLINE_COMMENTS=false

# TTL (secondes) de déduplication des delivery id des webhooks
NIALAME_WEBHOOK_DEDUP_TTL_SECONDS=600
